# Copy to .env (git-ignored) and change the password before `docker compose up -d --build`.
# The database is only reachable from the api container; it is not published on the host.
# Letters and digits only (it becomes part of a connection URL), e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=change-this-to-a-long-random-password
# Port of the app on this computer.
CRAFTFOLIO_PORT=8090
# auto: Secure session cookies when the site is reached over HTTPS (set true behind an HTTPS proxy).
COOKIE_SECURE=auto
# Optional: an Anthropic API key turns on "Tailor with Claude" for signed-in users (each use is billed
# to this key; 20 tailorings per user per hour). Without it, tailoring works by copy and paste.
ANTHROPIC_API_KEY=
# Optional: an OpenAI API key turns on "ChatGPT (connected)" the same way. Each use is billed to it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional and free: a Google Gemini API key (aistudio.google.com, "Get API key") turns on "Gemini (connected)".
# The free tier has daily limits, and Google may use free-tier data to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
